      "title": "JSONPath 语法不支持 ⇒ 真错误（规则写错了）",
      "kind": "diagnose",
      "requires": "swift-only",
      "base": {
        "type": "json",
        "value": {
          "a": 1
        }
      },
      "rule": "$.a[",
      "expect": {
        "conclusion": "unsupported",
        "hard": "1"
      }
    },
    {
      "id": "diag-03",
      "semantic": "S-DIA-07",
      "title": "选择器没匹配上 ⇒ 「规则没命中」（不是真错误）",
      "kind": "diagnose",
      "requires": "swift-only",
      "base": {
        "type": "html",
        "value": "<html><body><p class='x'>A</p></body></html>"
      },
      "rule": "div.nope",
      "expect": {
        "conclusion": "rule-not-matched",
        "hard": "0"
      }
    },
    {
      "id": "diag-04",
      "semantic": "S-DIA-07",
      "title": "JS 后端未接 ⇒ 真错误（不支持）",
      "kind": "diagnose",
      "requires": "swift-only",
      "base": {
        "type": "json",
        "value": {
          "a": 1
        }
      },
      "rule": "@js:result.a",
      "expect": {
        "conclusion": "unsupported",
        "hard": "1"
      }
    },
    {
      "id": "diag-05",
      "semantic": "S-DIA-07",
      "title": "正则语法错 ⇒ 真错误（规则写错了）",
      "kind": "diagnose",
      "requires": "swift-only",
      "base": {
        "type": "text",
        "value": "abc"
      },
      "rule": "##([unclosed##",
      "expect": {
        "conclusion": "unsupported",
        "hard": "1"
      }
    },
    {
      "id": "xpath-01",
      "semantic": "S-DOM-07",
      "title": "XPath 取属性 //h5/a/@href（爱丽丝书屋 ruleSearch.bookUrl）",
      "kind": "evalOne",
      "rule": "//h5/a/@href",
      "expect": {
        "count": 1,
        "texts": [
          "/book/1"
        ]
      },
      "base": {
        "type": "html",
        "value": "<html><body><div class=\"list-group\"><div class=\"list-group-item\"><h5><a href=\"/book/1\">书名一</a></h5></div></div></body></html>"
      }
    },
    {
      "id": "xpath-02",
      "semantic": "S-DOM-07",
      "title": "XPath 取文本 //h5/a/text()（爱丽丝书屋 ruleToc.chapterName）",
      "kind": "evalOne",
      "rule": "//h5/a/text()",
      "expect": {
        "count": 1,
        "texts": [
          "书名一"
        ]
      },
      "base": {
        "type": "html",
        "value": "<html><body><div class=\"list-group\"><div class=\"list-group-item\"><h5><a href=\"/book/1\">书名一</a></h5></div></div></body></html>"
      }
    },
    {
      "id": "xpath-03",
      "semantic": "S-DOM-07",
      "title": "XPath 含 contains() + 子路径（卡拉漫画 ruleExplore.bookList）",
      "kind": "evalOne",
      "rule": "//ul[contains(@class,'vodlist')]/li",
      "expect": {
        "count": 2,
        "texts": [
          "漫画一",
          "漫画二"
        ]
      },
      "base": {
        "type": "html",
        "value": "<html><body><ul class=\"vodlist\"><li>漫画一</li><li>漫画二</li></ul></body></html>"
      }
    },
    {
      "id": "xpath-04",
      "semantic": "S-DOM-07",
      "title": "XPath 通配 + 属性谓词 + 取属性（悦读小说 ruleBookInfo.coverUrl）",
      "kind": "evalOne",
      "rule": "//*[@property=\"og:image\"]/@content",
      "expect": {
        "count": 1,
        "texts": [
          "/cover.jpg"
        ]
      },
      "base": {
        "type": "html",
        "value": "<html><head><meta property=\"og:image\" content=\"/cover.jpg\"></head><body></body></html>"
      }
    },
    {
      "id": "xpath-05",
      "semantic": "S-DOM-07",
      "title": "XPath 多级路径 + 数字索引（1-based）（爱丽丝书屋 ruleBookInfo.author）",
      "kind": "evalOne",
      "rule": "//div[@class='box_info']/table/tbody/tr[1]/td/div/p[1]/a[1]/text()",
      "expect": {
        "count": 1,
        "texts": [
          "作者名"
        ]
      },
      "base": {
        "type": "html",
        "value": "<html><body><div class=\"box_info\"><table><tbody><tr><td><div><p><a>作者名</a><a>另一个</a></p></div></td></tr></tbody></table></div></body></html>"
      }
    },
    {
      "id": "xpath-06",
      "semantic": "S-DOM-07",
      "title": "XPath class 属性【完全相等】⇒ HTML 的 class 值本来就是空格分隔的整串 ⇒ 匹配得上（两边一致）",
      "kind": "evalOne",
      "rule": "//p[@class='mb-1 text-muted']/a/text()",
      "expect": {
        "count": 1,
        "texts": [
          "作者A"
        ]
      },
      "base": {
        "type": "html",
        "value": "<html><body><p class=\"mb-1 text-muted\"><a>作者A</a></p></body></html>"
      }
    },
    {
      "id": "url-01",
      "semantic": "S-URL-01",
      "title": "query 里的裸中文 ⇒ 百分号编码（build166 的坑）",
      "kind": "urlRule",
      "requires": "swift-only",
      "rule": "https://x.com/s?q=搜索词",
      "baseUrl": "",
      "expect": {
        "method": "GET",
        "body": "",
        "url": "https://x.com/s?q=%E6%90%9C%E7%B4%A2%E8%AF%8D"
      }
    },
    {
      "id": "url-02",
      "semantic": "S-URL-03",
      "title": "query 里的 + ⇒ %2B（base64 book_id 被损坏的坑）",
      "kind": "urlRule",
      "requires": "swift-only",
      "rule": "https://x.com/s?id=MTgzNTEy+q",
      "baseUrl": "",
      "expect": {
        "method": "GET",
        "body": "",
        "url": "https://x.com/s?id=MTgzNTEy%2Bq"
      }
    },
    {
      "id": "url-03",
      "semantic": "S-URL-01",
      "title": "已经是 %XX 的不重复编码",
      "kind": "urlRule",
      "requires": "swift-only",
      "rule": "https://x.com/s?q=a%20b",
      "baseUrl": "",
      "expect": {
        "method": "GET",
        "body": "",
        "url": "https://x.com/s?q=a%20b"
      }
    },
    {
      "id": "url-04",
      "semantic": "S-URL-04",
      "title": "对象 body ⇒ JSON + Content-Type",
      "kind": "urlRule",
      "requires": "swift-only",
      "rule": "https://x.com/api,{\"method\":\"POST\",\"body\":{\"a\":1}}",
      "baseUrl": "",
      "expect": {
        "method": "POST",
        "body": "{\"a\":1}",
        "url": "https://x.com/api",
        "contentType": "application/json; charset=utf-8"
      }
    },
    {
      "id": "url-05",
      "semantic": "S-URL-04",
      "title": "字符串 body ⇒ form 编码 + Content-Type",
      "kind": "urlRule",
      "requires": "swift-only",
      "rule": "https://x.com/api,{\"method\":\"POST\",\"body\":\"a=1&b=2\"}",
      "baseUrl": "",
      "expect": {
        "method": "POST",
        "body": "a=1&b=2",
        "url": "https://x.com/api",
        "contentType": "application/x-www-form-urlencoded; charset=utf-8"
      }
    },
    {
      "id": "url-06",
      "semantic": "S-URL-04",
      "title": "headers 透传 + 已有 Content-Type 不被覆盖（body 的 = 是结构符，不编码）",
      "kind": "urlRule",
      "requires": "swift-only",
      "rule": "https://x.com/api,{\"method\":\"POST\",\"headers\":{\"X-A\":\"1\",\"Content-Type\":\"text/plain\"},\"body\":\"x=1\"}",
      "baseUrl": "",
      "expect": {
        "method": "POST",
        "body": "x=1",
        "url": "https://x.com/api",
        "contentType": "text/plain",
        "xA": "1"
      }
    },
    {
      "id": "url-07",
      "semantic": "S-DAT-01",
      "title": "data: 伪 URL ⇒ 原样返回（百分号编码会毁掉 base64 载荷）",
      "kind": "urlRule",
      "requires": "swift-only",
      "rule": "data:;base64,eyJ0YWI6Im5vdmVsIn0+,{\"type\":\"qingtian\"}",
      "baseUrl": "",
      "expect": {
        "method": "GET",
        "body": "",
        "url": "data:;base64,eyJ0YWI6Im5vdmVsIn0+,{\"type\":\"qingtian\"}"
      }
    },
    {
      "id": "url-08",
      "semantic": "S-URL-01",
      "title": "相对地址 ⇒ 绝对化",
      "kind": "urlRule",
      "requires": "swift-only",
      "rule": "/api/book/1",
      "baseUrl": "https://book.example.com/",
      "expect": {
        "method": "GET",
        "body": "",
        "url": "https://book.example.com/api/book/1"
      }
    },
    {
      "id": "url-09",
      "semantic": "S-URL-01",
      "title": "协议相对地址 ⇒ 补上 baseUrl 的 scheme（跟参考实现一致）",
      "kind": "urlRule",
      "requires": "swift-only",
      "rule": "//cdn.example.com/a.png",
      "baseUrl": "https://book.example.com/",
      "expect": {
        "method": "GET",
        "body": "",
        "url": "https://cdn.example.com/a.png"
      }
    },
    {
      "id": "url-10",
      "semantic": "S-URL-01",
      "title": "GET ⇒ body 清空",
      "kind": "urlRule",
      "requires": "swift-only",
      "rule": "https://x.com/api,{\"method\":\"GET\",\"body\":\"a=1\"}",
      "baseUrl": "",
      "expect": {
        "method": "GET",
        "body": "",
        "url": "https://x.com/api"
      }
    },
    {
      "id": "url-11",
      "semantic": "S-URL-01",
      "title": "query 里的裸 JSON ⇒ 百分号编码（POST 也一样）",
      "kind": "urlRule",
      "requires": "swift-only",
      "rule": "https://x.com/d?book_id=x&source=番茄&variable={\"custom\":\"\"}",
      "baseUrl": "",
      "expect": {
        "method": "GET",
        "body": "",
        "url": "https://x.com/d?book_id=x&source=%E7%95%AA%E8%8C%84&variable=%7B%22custom%22%3A%22%22%7D"
      }
    },
    {
      "id": "url-12",
      "semantic": "S-URL-01",
      "title": "逗号后紧跟 { 才算选项后缀（否则是普通 URL）",
      "kind": "urlRule",
      "requires": "swift-only",
      "rule": "https://x.com/a,b",
      "baseUrl": "https://book.example.com/",
      "expect": {
        "method": "GET",
        "body": "",
        "url": "https://x.com/a,b"
      }
    },
    {
      "id": "fbk-04",
      "semantic": "S-FBK-04",
      "title": "换行多规则 ⇒ 结果合并（轻阅只返回第一行 ⇒ 债）",
      "kind": "getElements",
      "rule": "tag.h1@text\ntag.h2@text",
      "base": {
        "type": "html",
        "value": "<html><body><h1>主标题</h1><h2>副标题</h2></body></html>"
      },
      "ctx": {
        "baseUrl": "https://x.example/"
      },
      "expect": {
        "count": 2
      }
    },
    {
      "id": "comma-01",
      "semantic": "S-FBK-05",
      "title": "头段逗号 = CSS 并集（不是兜底链）",
      "kind": "getElements",
      "rule": "tag.h1, tag.h2",
      "base": {
        "type": "html",
        "value": "<html><body><h1>主标题</h1><h2>副标题</h2></body></html>"
      },
      "ctx": {
        "baseUrl": "https://x.example/"
      },
      "expect": {
        "count": 2
      }
    },
    {
      "id": "val-01",
      "semantic": "S-VAL-01",
      "title": "整条规则 = 取值模式（轻阅当 CSS 标签查 ⇒ 债）",
      "kind": "evalOne",
      "rule": "text",
      "base": {
        "type": "html",
        "value": "<html><body><h1>主标题</h1></body></html>"
      },
      "ctx": {
        "baseUrl": "https://x.example/"
      },
      "expect": {
        "value": "主标题"
      },
      "requires": "swift-only"
    },
    {
      "id": "json-07",
      "semantic": "S-JSON-07",
      "title": "`$.[*]` 取数组全部元素（列表口径）",
      "kind": "evalOne",
      "rule": "$.[*]",
      "base": {
        "type": "json",
        "value": [
          {
            "n": 1
          },
          {
            "n": 2
          }
        ]
      },
      "ctx": {
        "isJSON": true
      },
      "expect": {
        "values": [
          "{\"n\":1}",
          "{\"n\":2}"
        ]
      }
    },
    {
      "id": "json-08",
      "semantic": "S-JSON-08",
      "title": "过滤表达式 `[?(…)]`（栖阅 Sextant 风格）",
      "kind": "evalOne",
      "rule": "$.items[?(@.n > 1)].s",
      "base": {
        "type": "json",
        "value": {
          "items": [
            {
              "n": 1,
              "s": "一"
            },
            {
              "n": 2,
              "s": "二"
            },
            {
              "n": 3,
              "s": "三"
            }
          ]
        }
      },
      "ctx": {
        "isJSON": true
      },
      "expect": {
        "value": "二"
      }
    },
    {
      "id": "jsp-01",
      "semantic": "S-JS-09",
      "title": "纯 JS：末行表达式 = 完成值",
      "kind": "evalOne",
      "rule": "@js:1 + 2",
      "base": {
        "type": "html",
        "value": "<html></html>"
      },
      "ctx": {},
      "expect": {
        "value": "3"
      },
      "requires": "js-pure"
    },
    {
      "id": "jsp-02",
      "semantic": "S-JS-09",
      "title": "纯 JS：result 赋值后取到赋值",
      "kind": "evalOne",
      "rule": "@js:result = '赋值后';",
      "base": {
        "type": "html",
        "value": "<html></html>"
      },
      "ctx": {},
      "expect": {
        "value": "赋值后"
      },
      "requires": "js-pure"
    },
    {
      "id": "jsp-03",
      "semantic": "S-JS-09",
      "title": "纯 JS：JSON.parse/stringify 往返",
      "kind": "evalOne",
      "rule": "@js:JSON.stringify(JSON.parse('{\"a\":1}').a + 1)",
      "base": {
        "type": "html",
        "value": "<html></html>"
      },
      "ctx": {},
      "expect": {
        "value": "2"
      },
      "requires": "js-pure"
    },
    {
      "id": "jsp-04",
      "semantic": "S-RES-09",
      "title": "纯 JS：条目级 result = 那个对象的 JSON 视图",
      "kind": "evalOne",
      "rule": "@js:result.bid",
      "base": {
        "type": "html",
        "value": "<html><body><a href=\"/b\" bid=\"BID-7\">书名</a></body></html>"
      },
      "ctx": {},
      "expect": {
        "value": "BID-7"
      },
      "requires": "js-pure"
    },
    {
      "id": "jsp-05",
      "semantic": "S-JS-09",
      "title": "纯 JS：数组 map/filter",
      "kind": "evalOne",
      "rule": "@js:[1,2,3].filter(function(x){return x>1;}).map(function(x){return x*2;}).join('-')",
      "base": {
        "type": "html",
        "value": "<html></html>"
      },
      "ctx": {},
      "expect": {
        "value": "4-6"
      },
      "requires": "js-pure"
    }
  ]
}
